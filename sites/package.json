{
  "name": "permissions-documentation-validation",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "android-repo-docs --project .. check && android-repo-docs --project .. build --check",
    "test": "android-repo-docs --project .. build --check && node --test tests/*.test.mjs",
    "screenshots:manifest": "android-repo-docs --project .. screenshots manifest",
    "screenshots:render": "android-repo-docs --project .. screenshots render",
    "screenshots:check": "android-repo-docs --project .. screenshots check",
    "screenshots:update": "android-repo-docs --project .. screenshots update"
  }
}
