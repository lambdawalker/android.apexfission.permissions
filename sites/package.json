{
  "name": "permissions-documentation-validation",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "node scripts/sync-examples.mjs && node scripts/screenshots.mjs manifest && android-repo-setup --project .. build_docs --check",
    "screenshots:manifest": "node scripts/screenshots.mjs manifest",
    "test": "node --test scripts/tests/*.test.mjs",
    "screenshots:render": "node scripts/screenshots.mjs render",
    "screenshots:check": "node scripts/screenshots.mjs check",
    "screenshots:update": "node scripts/screenshots.mjs update"
  },
  "dependencies": {
    "sharp": "0.35.5"
  }
}
