---
import pages from '../../pages.json';
import scopes from '../../scopes.json';
import site from '../../site.json';
import { currentPage, selectorGroups, isDevelopment, repositoryUrl, versionScopes, destination } from '../../scripts/navigation.mjs';
import { patchVersion, versionOptions, publications, equivalentPeers } from './ReleasePresentation.mjs';
const evidence = [];
const prefix = (site.prefix || '').replace(/\/$/, '');
const page = currentPage(pages, Astro.url.pathname, prefix);
const scope = page && scopes[page.scope_index];
const guide = typeof page?.guide === 'string' ? page.guide : scope?.pages.find(p => p.href.replace(/\/$/, '') === Astro.url.pathname.replace(/\/$/, ''))?.slug || '';
const es = scope?.language === 'es';
const names = { Module: es ? 'Módulo' : 'Module', Version: es ? 'Versión' : 'Version', Language: es ? 'Idioma' : 'Language' };
const display = label => es && label === 'Development' ? 'Desarrollo' : label;
const groups = scope ? selectorGroups(scopes, scope, guide) : {};
if (scope) groups.Version = versionOptions(versionScopes(scopes, scope), scope, guide, destination, evidence);
const providers = scope ? publications(scopes, scope, evidence) : [];
const builder = scopes.find(candidate => candidate.development)?.source;
const raw = scope?.pages.find(p => p.slug === guide)?.raw;
const repository = repositoryUrl(site.repository);
const sourceUrl = scope?.source && repository ? `${repository}/commit/${encodeURIComponent(scope.source)}` : undefined;
---
{scope && <aside aria-label={es ? "Ámbito de documentación" : "Documentation scope"} class="scope-banner">
  <div class="selectors">{Object.entries(groups).map(([name, options]) => <label>{names[name]}<select data-doc-navigation aria-label={names[name]}>{options.map(option => <option value={option.href} selected={option.selected}>{display(option.label)}</option>)}</select></label>)}</div>
  <p class="provenance"><strong>{scope.module} · {isDevelopment(scope) ? (es ? 'Desarrollo (sin publicar)' : 'Development (unreleased)') : patchVersion(scope)}</strong>
  {scope.source && <> · {es ? 'Código' : 'Source'} {sourceUrl ? <a href={sourceUrl}>{scope.source.slice(0, 12)}</a> : scope.source}</>}
  {scope.documentation_ref && <> · {es ? 'Documentación' : 'Documentation'} {scope.documentation_ref}</>}
  {raw && <> · <a href={raw}>{es ? 'Markdown original' : 'Raw Markdown'}</a></>}
  </p>
  {providers.length > 0 && <div class="publication-details"><p>{es ? 'Disponible en' : 'Available on'} {providers.map(provider => <a href={provider.href}>{provider.name === 'maven-central' ? 'Maven Central' : 'JitPack'} </a>)}</p><details><summary>{es ? 'Detalles de publicación' : 'Publication details'}</summary><ul>{providers.map(provider => <li>{provider.name} · <a href={`${repository}/commit/${provider.source}`}><code>{provider.source}</code></a></li>)}</ul>{scope.translation_tree && <p>{es ? 'Traducción' : 'Translation'} · <code>{scope.translation_tree}</code></p>}{providers.length > 1 && equivalentPeers(scopes, scope, evidence).length > 1 && <p>{es ? 'Los archivos AAR, fuentes y Javadoc son idénticos en ambos repositorios.' : 'AAR, sources and Javadoc archives are identical in both repositories.'} <a href={`${prefix}/release-equivalence.json`}>SHA-256</a></p>}</details></div>}
  {builder && <p class="provenance">{es ? 'Revisión de compilación del sitio' : 'Site build revision'} · <a href={`${repository}/commit/${builder}`}>{builder}</a></p>}
  {page.fallback && <p role="note" class="fallback">{es ? 'Traducción no disponible para esta guía. Se muestra la documentación original.' : 'Translation unavailable for this guide. Showing the source documentation.'}</p>}
  <noscript><details><summary>{es ? 'Elegir documentación' : 'Choose documentation'}</summary>{Object.entries(groups).map(([name, options]) => <div><strong>{names[name]}</strong><ul>{options.map(option => <li><a href={option.href}>{display(option.label)}</a></li>)}</ul></div>)}</details></noscript>
</aside>}
<script>
function bind() {
  document.querySelectorAll<HTMLSelectElement>('select[data-doc-navigation]').forEach(select => {
    select.onchange = () => window.location.assign(select.value);
  });
}
bind();
document.addEventListener('astro:page-load', bind);
</script>

<style>.publication-details{max-width:76rem;margin:.65rem auto;font-size:.85rem}.publication-details p{margin:.5rem 0}.publication-details a{margin-right:.4rem}</style>
